+bool System::GetDImuState(Eigen::Vector3f& position, Eigen::Matrix3f& rotation,
+                          Eigen::Vector3f& velocity, IMU::Bias& bias)
+{
+    // 只改D的隔离源码副本。未初始化或失跟时不把预测状态当作可信SLAM状态。
+    unique_lock<mutex> lock(mMutexState);
+    if (mSensor != IMU_MONOCULAR && mSensor != IMU_STEREO && mSensor != IMU_RGBD)
+        return false;
+    Frame& frame = mpTracker->mCurrentFrame;
+    if (mTrackingState != Tracking::OK || !mpAtlas->isImuInitialized() ||
+        !frame.HasPose() || !frame.HasVelocity())
+        return false;
+    position = frame.GetImuPosition();
+    rotation = frame.GetImuRotation();
+    velocity = frame.GetVelocity();
+    bias = frame.mImuBias;
+    return true;
+}
